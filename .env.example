# (.env ถูก ignore ไว้ใน git จะไม่ถูก commit ขึ้นไป)

# บน Windows พอร์ต 5000 มักถูกระบบจองไว้ (เช็คด้วย:
# netsh interface ipv4 show excludedportrange protocol=tcp)
# ถ้าเจอ error "An attempt was made to access a socket in a way forbidden by
# its access permissions" ให้เปลี่ยนเลขพอร์ตตรงนี้
PORT=5001

FLASK_DEBUG=1
